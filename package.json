{
  "name": "@zj669/codeq",
  "version": "0.3.13",
  "description": "Local file, text, and code-graph search from a CLI or MCP server",
  "type": "module",
  "mcpName": "io.github.zj669/codeq",
  "bin": {
    "codeq": "./bin/codeq.js",
    "codeq-mcp": "./bin/codeq-mcp"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "server.json"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-codegraph.mjs",
    "verify:patch": "node scripts/patch-codegraph.mjs --check",
    "test": "node --test test/*.test.js",
    "eval": "node eval/run.js"
  },
  "engines": {
    "node": ">=22.5 <25"
  },
  "keywords": [
    "mcp",
    "code-search",
    "grep",
    "find",
    "codegraph",
    "fff",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zj669/agent_local_search.git"
  },
  "homepage": "https://github.com/zj669/agent_local_search",
  "bugs": {
    "url": "https://github.com/zj669/agent_local_search/issues"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "1.6.0",
    "@ff-labs/fff-node": "0.11.0",
    "@typesafe-ai/sdk": "0.6.0"
  },
  "license": "MIT"
}
